# Copy this file to .env and fill in real values. Never commit the real .env.

# Deployer key used by script/DeployCoston2.s.sol and script/RegisterEnclave.s.sol (must hold C2FLR for gas)
PRIVATE_KEY=0xyour_private_key_here

# Coston2 (Flare testnet) JSON-RPC endpoint
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Blockscout verification (any non-empty string works, Blockscout does not enforce real API keys)
BLOCKSCOUT_API_KEY=blockscout

# Vault fee recipients
TREASURY_ADDRESS=0xYourTreasuryAddress
STRATEGIST_ADDRESS=0xYourStrategistAddress

# Underlying ERC-20 asset the vault accepts (e.g. a USDC-equivalent test token on Coston2)
VAULT_ASSET_ADDRESS=0xUnderlyingAssetAddress

# External integrations (Coston2 addresses)
DEX_ROUTER_ADDRESS=0xDexRouterAddress
FTSO_V2_ADDRESS=0xFtsoV2Address
FDC_VERIFICATION_ADDRESS=0xFdcVerificationAddress

# StrategyRegistry bond token + strategy metadata
BOND_TOKEN_ADDRESS=0xBondTokenAddress
STRATEGY_NAME="Eclipse Momentum Strategy"
BOND_AMOUNT=1000000000000000000000

# script/RegisterEnclave.s.sol inputs (populated once the enclave has produced a real attestation)
ALPHA_VAULT_ADDRESS=0xDeployedAlphaVaultAddress
ENCLAVE_REGISTRY_ADDRESS=0xDeployedEnclaveRegistryAddress
PERFORMANCE_LEDGER_ADDRESS=0xDeployedPerformanceLedgerAddress
ENCLAVE_SIGNER_ADDRESS=0xEnclavePublicKeyAddress
FDC_ATTESTATION_PROOF=0xabiEncodedIWeb2JsonProofBytes
